		/* DOUT GPIOs (32 output channels) - formula: (i/4)*24 + 20 + (i%4) */
		dout-gpios = <&axi_gpio_0 20 GPIO_ACTIVE_HIGH>,  /* dout0 */
		             <&axi_gpio_0 21 GPIO_ACTIVE_HIGH>,  /* dout1 */
		             <&axi_gpio_0 22 GPIO_ACTIVE_HIGH>,  /* dout2 */

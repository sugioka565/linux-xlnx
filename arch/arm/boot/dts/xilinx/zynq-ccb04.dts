		msw1_6	{ gpios = <&lp5860t_0 35 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_1 33 GPIO_ACTIVE_HIGH>; };
		msw2_6	{ gpios = <&lp5860t_0 36 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_1 34 GPIO_ACTIVE_HIGH>; };

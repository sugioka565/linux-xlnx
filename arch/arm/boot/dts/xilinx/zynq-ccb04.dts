	ccb04_dio_smon {
		compatible = "custom,ccb04_dio_smon";
		status = "okay";

		/* DIN GPIOs (32 input channels) - formula: (i/4)*24 + 16 + (i%4) */
		din-gpios = <&axi_gpio_0 16 GPIO_ACTIVE_HIGH>,  /* din0 */
		            <&axi_gpio_0 17 GPIO_ACTIVE_HIGH>,  /* din1 */

		              <&axi_gpio_2 37 GPIO_ACTIVE_HIGH>,  /* dstat11[2] */
		              <&axi_gpio_3 8 GPIO_ACTIVE_HIGH>,   /* dstat12[0] */
		              <&axi_gpio_3 9 GPIO_ACTIVE_HIGH>,   /* dstat12[1] */
		              <&axi_gpio_3 10 GPIO_ACTIVE_HIGH>,  /* dstat12[2] */
		              <&axi_gpio_3 11 GPIO_ACTIVE_HIGH>,  /* dstat13[0] */
		              <&axi_gpio_3 12 GPIO_ACTIVE_HIGH>,  /* dstat13[1] */
		              <&axi_gpio_3 13 GPIO_ACTIVE_HIGH>,  /* dstat13[2] */
		              <&axi_gpio_3 32 GPIO_ACTIVE_HIGH>,  /* dstat14[0] */
		              <&axi_gpio_3 33 GPIO_ACTIVE_HIGH>,  /* dstat14[1] */
		              <&axi_gpio_3 34 GPIO_ACTIVE_HIGH>,  /* dstat14[2] */
		              <&axi_gpio_3 35 GPIO_ACTIVE_HIGH>,  /* dstat15[0] */
		              <&axi_gpio_3 36 GPIO_ACTIVE_HIGH>,  /* dstat15[1] */
		              <&axi_gpio_3 37 GPIO_ACTIVE_HIGH>;  /* dstat15[2] */

		/* DCTL GPIOs (16 devices x 3 bits = 48 entries) - formula: (dev/2)*24 + (dev%2)*2 + dctl_bit_offsets[bit] */
		/* dctl_bit_offsets = [0, 1, 14] */
		dctl-gpios = <&axi_gpio_0 0 GPIO_ACTIVE_HIGH>,   /* dctl0[0] */
		             <&axi_gpio_0 1 GPIO_ACTIVE_HIGH>,   /* dctl0[1] */
		             <&axi_gpio_0 14 GPIO_ACTIVE_HIGH>,  /* dctl0[2] */
		             <&axi_gpio_0 2 GPIO_ACTIVE_HIGH>,   /* dctl1[0] */
		             <&axi_gpio_0 3 GPIO_ACTIVE_HIGH>,   /* dctl1[1] */
		             <&axi_gpio_0 15 GPIO_ACTIVE_HIGH>,  /* dctl1[2] - adjusted to avoid conflict */
		             <&axi_gpio_0 24 GPIO_ACTIVE_HIGH>,  /* dctl2[0] */
		             <&axi_gpio_0 25 GPIO_ACTIVE_HIGH>,  /* dctl2[1] */
		             <&axi_gpio_0 38 GPIO_ACTIVE_HIGH>,  /* dctl2[2] */
		             <&axi_gpio_0 26 GPIO_ACTIVE_HIGH>,  /* dctl3[0] */
		             <&axi_gpio_0 27 GPIO_ACTIVE_HIGH>,  /* dctl3[1] */
		             <&axi_gpio_0 39 GPIO_ACTIVE_HIGH>,  /* dctl3[2] */
		             <&axi_gpio_1 0 GPIO_ACTIVE_HIGH>,   /* dctl4[0] */
		             <&axi_gpio_1 1 GPIO_ACTIVE_HIGH>,   /* dctl4[1] */
		             <&axi_gpio_1 14 GPIO_ACTIVE_HIGH>,  /* dctl4[2] */
		             <&axi_gpio_1 2 GPIO_ACTIVE_HIGH>,   /* dctl5[0] */
		             <&axi_gpio_1 3 GPIO_ACTIVE_HIGH>,   /* dctl5[1] */
		             <&axi_gpio_1 15 GPIO_ACTIVE_HIGH>,  /* dctl5[2] */
		             <&axi_gpio_1 24 GPIO_ACTIVE_HIGH>,  /* dctl6[0] */
		             <&axi_gpio_1 25 GPIO_ACTIVE_HIGH>,  /* dctl6[1] */
		             <&axi_gpio_1 38 GPIO_ACTIVE_HIGH>,  /* dctl6[2] */
		             <&axi_gpio_1 26 GPIO_ACTIVE_HIGH>,  /* dctl7[0] */
		             <&axi_gpio_1 27 GPIO_ACTIVE_HIGH>,  /* dctl7[1] */
		             <&axi_gpio_1 39 GPIO_ACTIVE_HIGH>,  /* dctl7[2] */
		             <&axi_gpio_2 0 GPIO_ACTIVE_HIGH>,   /* dctl8[0] */
		             <&axi_gpio_2 1 GPIO_ACTIVE_HIGH>,   /* dctl8[1] */
		             <&axi_gpio_2 14 GPIO_ACTIVE_HIGH>,  /* dctl8[2] */
		             <&axi_gpio_2 2 GPIO_ACTIVE_HIGH>,   /* dctl9[0] */
		             <&axi_gpio_2 3 GPIO_ACTIVE_HIGH>,   /* dctl9[1] */
		             <&axi_gpio_2 15 GPIO_ACTIVE_HIGH>,  /* dctl9[2] */
		             <&axi_gpio_2 24 GPIO_ACTIVE_HIGH>,  /* dctl10[0] */
		             <&axi_gpio_2 25 GPIO_ACTIVE_HIGH>,  /* dctl10[1] */
		             <&axi_gpio_2 38 GPIO_ACTIVE_HIGH>,  /* dctl10[2] */
		             <&axi_gpio_2 26 GPIO_ACTIVE_HIGH>,  /* dctl11[0] */
		             <&axi_gpio_2 27 GPIO_ACTIVE_HIGH>,  /* dctl11[1] */
		             <&axi_gpio_2 39 GPIO_ACTIVE_HIGH>,  /* dctl11[2] */
		             <&axi_gpio_3 0 GPIO_ACTIVE_HIGH>,   /* dctl12[0] */
		             <&axi_gpio_3 1 GPIO_ACTIVE_HIGH>,   /* dctl12[1] */
		             <&axi_gpio_3 14 GPIO_ACTIVE_HIGH>,  /* dctl12[2] */
		             <&axi_gpio_3 2 GPIO_ACTIVE_HIGH>,   /* dctl13[0] */
		             <&axi_gpio_3 3 GPIO_ACTIVE_HIGH>,   /* dctl13[1] */
		             <&axi_gpio_3 15 GPIO_ACTIVE_HIGH>,  /* dctl13[2] */
		             <&axi_gpio_3 24 GPIO_ACTIVE_HIGH>,  /* dctl14[0] */
		             <&axi_gpio_3 25 GPIO_ACTIVE_HIGH>,  /* dctl14[1] */
		             <&axi_gpio_3 38 GPIO_ACTIVE_HIGH>,  /* dctl14[2] */
		             <&axi_gpio_3 26 GPIO_ACTIVE_HIGH>,  /* dctl15[0] */
		             <&axi_gpio_3 27 GPIO_ACTIVE_HIGH>,  /* dctl15[1] */
		             <&axi_gpio_3 39 GPIO_ACTIVE_HIGH>;  /* dctl15[2] */

		smon0-gpios = <&gpio0 72 GPIO_ACTIVE_HIGH>,
			      <&gpio0 73 GPIO_ACTIVE_HIGH>,
			      <&gpio0 74 GPIO_ACTIVE_HIGH>,
			      <&gpio0 75 GPIO_ACTIVE_HIGH>,
			      <&gpio0 76 GPIO_ACTIVE_HIGH>,
			      <&gpio0 77 GPIO_ACTIVE_HIGH>,
			      <&gpio0 78 GPIO_ACTIVE_HIGH>,
			      <&gpio0 79 GPIO_ACTIVE_HIGH>,
			      <&gpio0 80 GPIO_ACTIVE_HIGH>,
			      <&gpio0 81 GPIO_ACTIVE_HIGH>,
			      <&gpio0 82 GPIO_ACTIVE_HIGH>,
			      <&gpio0 83 GPIO_ACTIVE_HIGH>,
			      <&gpio0 84 GPIO_ACTIVE_HIGH>,
			      <&gpio0 85 GPIO_ACTIVE_HIGH>,
			      <&gpio0 86 GPIO_ACTIVE_HIGH>,
			      <&gpio0 87 GPIO_ACTIVE_HIGH>;
		smon-gpios = <&gpio0 62 GPIO_ACTIVE_HIGH>, /* error */
			     <&gpio0 63 GPIO_ACTIVE_HIGH>, /* power */
			     <&gpio0 64 GPIO_ACTIVE_HIGH>; /* run */

		/* SMON4 GPIO (single input from PS GPIO) */
		smon4-gpios = <&gpio0 61 GPIO_ACTIVE_HIGH>;
	};

	amba_pl: amba_pl {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges ;
		clocking1: clocking1 {
			compatible = "xlnx,fclk";
			assigned-clocks = <&clkc 16>;
			assigned-clock-rates = <25000000>;
			#clock-cells = <0>;
			clock-output-names = "fabric_clk";
			clocks = <&clkc 16>;
		};
		clocking0: clocking0 {
			compatible = "xlnx,fclk";
			assigned-clocks = <&clkc 15>;
			assigned-clock-rates = <100000000>;
			#clock-cells = <0>;
			clock-output-names = "fabric_clk";
			clocks = <&clkc 15>;
		};
		axi_gpio_0: gpio@81200000 {
			#interrupt-cells = <2>;
			interrupts = < 0 53 4 >;
			xlnx,gpio-board-interface = "Custom";
			compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <24>;
			interrupt-parent = <&intc>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <1>;
			xlnx,ip-name = "axi_gpio";
			xlnx,tri-default-2 = <0xffffffff>;
			reg = <0x81200000 0x10000>;
			xlnx,all-inputs-2 = <0>;
			clocks = <&clkc 15>;
			xlnx,all-outputs-2 = <0>;
			gpio-controller;
			xlnx,interrupt-present = <1>;
			xlnx,gpio2-board-interface = "Custom";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,dout-default-2 = <0x0>;
			status = "okay";
			xlnx,gpio2-width = <24>;
			clock-names = "s_axi_aclk";
			interrupt-controller;
			interrupt-names = "ip2intc_irpt";
			xlnx,tri-default = <0xffffffff>;
			xlnx,name = "axi_gpio_0";
			xlnx,all-inputs = <0>;
		};
		axi_gpio_1: gpio@81210000 {
			#interrupt-cells = <2>;
			interrupts = < 0 54 4 >;
			xlnx,gpio-board-interface = "Custom";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <24>;
			interrupt-parent = <&intc>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <1>;
			xlnx,ip-name = "axi_gpio";
			xlnx,tri-default-2 = <0xffffffff>;
			reg = <0x81210000 0x10000>;
			xlnx,all-inputs-2 = <0>;
			clocks = <&clkc 15>;
			xlnx,all-outputs-2 = <0>;
			gpio-controller;
			xlnx,interrupt-present = <1>;
			xlnx,gpio2-board-interface = "Custom";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,dout-default-2 = <0x0>;
			status = "okay";
			xlnx,gpio2-width = <24>;
			clock-names = "s_axi_aclk";
			interrupt-controller;
			interrupt-names = "ip2intc_irpt";
			xlnx,tri-default = <0xffffffff>;
			xlnx,name = "axi_gpio_1";
			xlnx,all-inputs = <0>;
		};
		axi_gpio_2: gpio@81220000 {
			#interrupt-cells = <2>;
			interrupts = < 0 55 4 >;
			xlnx,gpio-board-interface = "Custom";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <24>;
			interrupt-parent = <&intc>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <1>;
			xlnx,ip-name = "axi_gpio";
			xlnx,tri-default-2 = <0xffffffff>;
			reg = <0x81220000 0x10000>;
			xlnx,all-inputs-2 = <0>;
			clocks = <&clkc 15>;
			xlnx,all-outputs-2 = <0>;
			gpio-controller;
			xlnx,interrupt-present = <1>;
			xlnx,gpio2-board-interface = "Custom";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,dout-default-2 = <0x0>;
			status = "okay";
			xlnx,gpio2-width = <24>;
			clock-names = "s_axi_aclk";
			interrupt-controller;
			interrupt-names = "ip2intc_irpt";
			xlnx,tri-default = <0xffffffff>;
			xlnx,name = "axi_gpio_2";
			xlnx,all-inputs = <0>;
		};
		axi_gpio_3: gpio@81230000 {
			#interrupt-cells = <2>;
			interrupts = < 0 56 4 >;
			xlnx,gpio-board-interface = "Custom";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <24>;
			interrupt-parent = <&intc>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <1>;
			xlnx,ip-name = "axi_gpio";
			xlnx,tri-default-2 = <0xffffffff>;
			reg = <0x81230000 0x10000>;
			xlnx,all-inputs-2 = <0>;
			clocks = <&clkc 15>;
			xlnx,all-outputs-2 = <0>;
			gpio-controller;
			xlnx,interrupt-present = <1>;
			xlnx,gpio2-board-interface = "Custom";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,dout-default-2 = <0x0>;
			status = "okay";
			xlnx,gpio2-width = <24>;
			clock-names = "s_axi_aclk";
			interrupt-controller;
			interrupt-names = "ip2intc_irpt";
			xlnx,tri-default = <0xffffffff>;
			xlnx,name = "axi_gpio_3";
			xlnx,all-inputs = <0>;
		};
		axi_iic_0: i2c@40000000 {
			single-master;
			clock-frequency = <100000>;
			interrupts = < 0 35 4 >;
			xlnx,iic-freq-khz = <100>;
			compatible = "xlnx,axi-iic-2.1";
			xlnx,scl-inertial-delay = <0>;
			interrupt-parent = <&intc>;
			xlnx,ip-name = "axi_iic";
			xlnx,disable-setup-violation-check = <0>;
			reg = <0x40000000 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clkc 15>;
			xlnx,gpo-width = <1>;
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,static-timing-reg-width = <0>;
			xlnx,sda-level = <1>;
			status = "okay";
			clock-names = "s_axi_aclk";
			xlnx,ten-bit-adr = <0>;
			xlnx,default-value = <0x0>;
			interrupt-names = "iic2intc_irpt";
			xlnx,iic-board-interface = "Custom";
			xlnx,timing-reg-width = <32>;
			xlnx,iic-freq = <100000>;
			xlnx,smbus-pmbus-host = <0>;
			xlnx,name = "axi_iic_0";
			xlnx,axi-aclk-freq-mhz = <100>;
			xlnx,sda-inertial-delay = <0>;
		};
		axi_iic_2: i2c@40010000 {
			single-master;
			clock-frequency = <100000>;
			interrupts = < 0 36 4 >;
			xlnx,iic-freq-khz = <100>;
			compatible = "xlnx,axi-iic-2.1";
			xlnx,scl-inertial-delay = <0>;
			interrupt-parent = <&intc>;
			xlnx,ip-name = "axi_iic";
			xlnx,disable-setup-violation-check = <0>;
			reg = <0x40010000 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clkc 15>;
			xlnx,gpo-width = <1>;
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,static-timing-reg-width = <0>;
			xlnx,sda-level = <1>;
			status = "okay";
			clock-names = "s_axi_aclk";
			xlnx,ten-bit-adr = <0>;
			xlnx,default-value = <0x0>;
			interrupt-names = "iic2intc_irpt";
			xlnx,iic-board-interface = "Custom";
			xlnx,timing-reg-width = <32>;
			xlnx,iic-freq = <100000>;
			xlnx,smbus-pmbus-host = <0>;
			xlnx,name = "axi_iic_1";
			xlnx,axi-aclk-freq-mhz = <100>;
			xlnx,sda-inertial-delay = <0>;
		};
		axi_iic_3: i2c@40020000 {
			single-master;
			clock-frequency = <100000>;
			interrupts = < 0 52 4 >;
			xlnx,iic-freq-khz = <100>;
			compatible = "xlnx,axi-iic-2.1";
			xlnx,scl-inertial-delay = <0>;
			interrupt-parent = <&intc>;
			xlnx,ip-name = "axi_iic";
			xlnx,disable-setup-violation-check = <0>;
			reg = <0x40020000 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clkc 15>;
			xlnx,gpo-width = <1>;
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,static-timing-reg-width = <0>;
			xlnx,sda-level = <1>;
			status = "okay";
			clock-names = "s_axi_aclk";
			xlnx,ten-bit-adr = <0>;
			xlnx,default-value = <0x0>;
			interrupt-names = "iic2intc_irpt";
			xlnx,iic-board-interface = "Custom";
			xlnx,timing-reg-width = <32>;
			xlnx,iic-freq = <100000>;
			xlnx,smbus-pmbus-host = <0>;
			xlnx,name = "axi_iic_1";
			xlnx,axi-aclk-freq-mhz = <100>;
			xlnx,sda-inertial-delay = <0>;
		};
		axi_rs485_0: axi_rs485@40030000 {
			clock-frequency = <100000000>;
			clock-names = "s_axi_aclk";
			clocks = <&clkc 15>;
			compatible = "ns16550a";
			device_type = "serial";
			reg-offset = <0x1000>;
			reg-shift = <2>;
			interrupt-names = "ip2intc_irpt";
			interrupt-parent = <&intc>;
			fifo-size = <16>;
			interrupts = < 0 31 4 >;
			reg = <0x40030000 0x10000>;
		};
		axi_rs485_1: axi_rs485@40040000 {
			clock-frequency = <100000000>;
			clock-names = "s_axi_aclk";
			clocks = <&clkc 15>;
			compatible = "ns16550a";
			device_type = "serial";
			reg-offset = <0x1000>;
			reg-shift = <2>;
			interrupt-parent = <&intc>;
			fifo-size = <16>;
			interrupts = < 0 32 4 >;
			reg = <0x40040000 0x10000>;
		};
		axi_rs485_2: axi_rs485@40050000 {
			clock-frequency = <100000000>;
			clock-names = "s_axi_aclk";
			clocks = <&clkc 15>;
			compatible = "ns16550a";
			device_type = "serial";
			reg-offset = <0x1000>;
			reg-shift = <2>;
			interrupt-parent = <&intc>;
			fifo-size = <16>;
			interrupts = < 0 33 4 >;
			reg = <0x40050000 0x10000>;
		};
		axi_rs485_3: axi_rs485@40060000 {
			clock-frequency = <100000000>;
			clock-names = "s_axi_aclk";
			clocks = <&clkc 15>;
			compatible = "ns16550a";
			device_type = "serial";
			reg-offset = <0x1000>;
			reg-shift = <2>;
			interrupt-parent = <&intc>;
			fifo-size = <16>;
			interrupts = < 0 34 4 >;
			reg = <0x40060000 0x10000>;
		};
		axi_uart16550_0: serial@40070000 {
			clock-frequency = <100000000>;
			compatible = "ns16550a";
			device_type = "serial";
			reg-offset = <0x1000>;
			reg-shift = <2>;
			interrupt-parent = <&intc>;
			interrupts = < 0 57 4 >;
			fifo-size = <16>;
			reg = <0x40070000 0x10000>;
		};
	};
	sdhci1_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio0 109 GPIO_ACTIVE_HIGH>;
	};

	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio0 104 GPIO_ACTIVE_HIGH>;
		/* シャットダウン時にGPIO 104をHIGHに駆動して電源を切断 */
		/* ハードウェアの仕様に応じてGPIO_ACTIVE_LOWに変更する必要がある場合があります */
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		power-button {
			label = "Power Button";
			/* パワーオフをトリガーするGPIOピン番号を指定 */
			gpios = <&gpio0 54 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_POWER>;
			debounce-interval = <50>; /* 50ms デバウンス */
			wakeup-source;
		};
		power-button-2 {
			label = "Power Button";
			/* パワーオフをトリガーするGPIOピン番号を指定 */
			gpios = <&gpio0 55 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_POWER>;
			debounce-interval = <50>; /* 50ms デバウンス */
			wakeup-source;
		};
		power-button-3 {
			label = "Power Button";
			/* パワーオフをトリガーするGPIOピン番号を指定 */
			gpios = <&gpio0 56 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_POWER>;
			debounce-interval = <50>; /* 50ms デバウンス */
			wakeup-source;
		};
	};
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gem0_rgmii>;
	mdio0: mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet_phy1: ethernet-phy@1 {
			reg = <1>;
			device_type = "ethernet-phy";
			micrel,individual-led-mode;
		};
		ethernet_phy2: ethernet-phy@2 {
			reg = <2>;
			device_type = "ethernet-phy";
			micrel,individual-led-mode;
		};
	};
};
&gem1 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gem1_rgmii>;
};
&gpio0 {
	emio-gpio-width = <64>;
	gpio-mask-high = <0x0>;
	gpio-mask-low = <0x5600>;
};
&axi_iic_0 {
	rtc: mcp7940x@6f {
		compatible = "microchip,mcp7940x";
		reg = <0x6f>;
	};
};
&axi_iic_2 {
	lp5860t_0: lp5860t_0@40 {
		compatible = "ti,lp5860t";
		reg = <0x40>;
		gpio-controller;
		#gpio-cells = <2>;
		/* SW線とCS線の数を設定 */
		ti,num-sw = <7>;   /* SW0-SW6 */
		ti,num-cs = <16>;   /* CS0-CS15 */
	};
};
&axi_iic_3 {
	lp5860t_1: lp5860t_1@40 {
		compatible = "ti,lp5860t";
		reg = <0x40>;
		gpio-controller;
		#gpio-cells = <2>;
		/* SW線とCS線の数を設定 */
		ti,num-sw = <7>;   /* SW0-SW6 */
		ti,num-cs = <16>;   /* CS0-CS15 */
	};
};
&intc {
	num_cpus = <2>;
	num_interrupts = <96>;
};
&qspi {
	is-dual = <0>;
	num-cs = <1>;
	spi-rx-bus-width = <4>;
	spi-tx-bus-width = <4>;
	status = "okay";
	xlnx,qspi-mode = <0x1>;
	xlnx,fb-clk = <0x0>;
	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		spi-max-frequency = <50000000>;
		partition@0 {
			/* 5MB for BOOT.BIN (zynq_fsbl.elf, system.bit, u-boot.elf, system.dtb)*/
			label = "boot";
			reg = <0x00000000 0x00500000>;
		};
		partition@1 {
			/* 128KB for u-boot environment variable */
			label = "bootenv";
			reg = <0x00500000 0x00020000>;
		};
		partition@2 {
			/* 10.5MB for linux kernel */
			label = "kernel";
			reg = <0x00520000 0x00a80000>;
		};
		partition@3 {
			/* u-boot boot script */
			label = "boot_script";
			reg = <0x00fa0000 0x00000000>;
		};
	};
};
&sdhci0 {
	status = "okay";
	xlnx,has-cd = <0x1>;
	xlnx,has-power = <0x0>;
	xlnx,has-wp = <0x0>;
	no-1-8-v;
};
&sdhci1 {
	status = "okay";
	xlnx,has-cd = <0x0>;
	xlnx,has-power = <0x0>;
	xlnx,has-wp = <0x0>;
	no-1-8-v;
	mmc-pwrseq = <&sdhci1_pwrseq>;
};
&uart0 {
	cts-override ;
	device_type = "serial";
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart0_default>;
};
&uart1 {
	device_type = "serial";
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1_default>;
};
&clkc {
	fclk-enable = <0x3>;
	ps-clk-frequency = <33333333>;
};
&watchdog0 {
	timeout-sec = <120>;
	reset-on-timeout;
};
&pinctrl0 {
	/* GEM0 RGMII: MIO16–27 */
	pinctrl_gem0_rgmii: gem0-rgmii-default {
		mux {
			groups = "ethernet0_0_grp";
			function = "ethernet0";
		};
		conf-ethernet0 {
			groups = "ethernet0_0_grp";
			slew-rate = <1>; /* Fast slew rate */
			power-source = <1>; /* LVCMOS18 */
		};
		conf-rx {
			pins = "MIO22", "MIO23", "MIO24", "MIO25", "MIO26", "MIO27";
			bias-high-impedance;
			low-power-disable; /* enable receiver */
		};
		conf-tx {
			pins = "MIO16", "MIO17", "MIO18", "MIO19", "MIO20", "MIO21";
			bias-disable;
			low-power-enable; /* disable receiver */
		};
		/* MDIO(MIO52/53) を GEM0 側の MDIO0 に割当て */
		mux-mdio {
			groups = "mdio0_0_grp";
			function = "mdio0";
		};
		conf-mdio {
			groups = "mdio0_0_grp";
			slew-rate = <0>; /* Slow slew rate */
			power-source = <1>; /* LVCMOS18 */
			bias-disable;
		};
	};

	/* GEM1 RGMII: MIO28–39 */
	pinctrl_gem1_rgmii: gem1-rgmii-default {
		mux {
			groups = "ethernet1_0_grp";
			function = "ethernet1";
		};
		conf-ethernet1 {
			groups = "ethernet1_0_grp";
			slew-rate = <1>; /* Fast slew rate */
			power-source = <1>; /* LVCMOS18 */
		};
		conf-rx {
			pins = "MIO34", "MIO35", "MIO36", "MIO37", "MIO38", "MIO39";
			bias-high-impedance;
			low-power-disable; /* enable receiver */
		};
		conf-tx {
			pins = "MIO28", "MIO29", "MIO30", "MIO31", "MIO32", "MIO33";
			bias-disable;
			low-power-enable; /* disable receiver */
		};
	};
	pinctrl_uart0_default: uart0-default {
		mux {
			groups = "uart0_1_grp";
			function = "uart0";
		};

		conf {
			groups = "uart0_1_grp";
			slew-rate = <0>; /* Slow slew rate */
			power-source = <3>; /* LVCMOS33 */
		};

		conf-rx {
			pins = "MIO14";
			bias-high-impedance;
		};

		conf-tx {
			pins = "MIO15";
			bias-disable;
		};
	};
	pinctrl_uart1_default: uart1-default {
		mux {
			groups = "uart1_1_grp";
			function = "uart1";
		};

		conf {
			groups = "uart1_1_grp";
			slew-rate = <0>; /* Slow slew rate */
			power-source = <3>; /* LVCMOS33 */
		};

		conf-rx {
			pins = "MIO13";
			bias-high-impedance;
		};

		conf-tx {
			pins = "MIO12";
			bias-disable;
		};
	};
};

/dts-v1/;
#include "zynq-7000.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

/ {
	model = "Hitachi CCB-04 board";
	compatible = "xlnx,zynq-7000";
	system-revision = <0x0001>;

	aliases {
		ethernet0 = &gem0;
		ethernet1 = &gem1;
		gpio1000 = &gpio0;
		i2c0 = &axi_iic_0;
		i2c2 = &axi_iic_2;
		i2c3 = &axi_iic_3;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &axi_rs485_0;
		serial3 = &axi_rs485_1;
		serial4 = &axi_rs485_2;
		serial5 = &axi_rs485_3;
		serial6 = &axi_uart16550_0;
		spi0 = &qspi;
		flash0 = &flash0;
	};

	cpus {
		cpu@0 {
			operating-points = <666666 1000000 333333 1000000>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00100000 0x3ff00000>;
	};

	chosen {
		bootargs = "console=ttyPS0,115200 root=/dev/mmcblk1p1 rw rootwait";
		stdout-path = "serial0:115200n8";
	};
	tbb_leds {
		compatible = "gpio-leds";
		tbb_0_0 { gpios = <&axi_gpio_0 5  GPIO_ACTIVE_HIGH>; };
		tbb_0_1 { gpios = <&axi_gpio_0 6  GPIO_ACTIVE_HIGH>; };
		tbb_0_2 { gpios = <&axi_gpio_0 7  GPIO_ACTIVE_HIGH>; };
		tbb_1_0 { gpios = <&axi_gpio_0 29 GPIO_ACTIVE_HIGH>; };
		tbb_1_1 { gpios = <&axi_gpio_0 30 GPIO_ACTIVE_HIGH>; };
		tbb_1_2 { gpios = <&axi_gpio_0 31 GPIO_ACTIVE_HIGH>; };
		tbb_2_0 { gpios = <&axi_gpio_1 5  GPIO_ACTIVE_HIGH>; };
		tbb_2_1 { gpios = <&axi_gpio_1 6  GPIO_ACTIVE_HIGH>; };
		tbb_2_2 { gpios = <&axi_gpio_1 7  GPIO_ACTIVE_HIGH>; };
		tbb_3_0 { gpios = <&axi_gpio_1 29 GPIO_ACTIVE_HIGH>; };
		tbb_3_1 { gpios = <&axi_gpio_1 30 GPIO_ACTIVE_HIGH>; };
		tbb_3_2 { gpios = <&axi_gpio_1 31 GPIO_ACTIVE_HIGH>; };
		tbb_4_0 { gpios = <&axi_gpio_2 5  GPIO_ACTIVE_HIGH>; };
		tbb_4_1 { gpios = <&axi_gpio_2 6  GPIO_ACTIVE_HIGH>; };
		tbb_4_2 { gpios = <&axi_gpio_2 7  GPIO_ACTIVE_HIGH>; };
		tbb_5_0 { gpios = <&axi_gpio_2 29 GPIO_ACTIVE_HIGH>; };
		tbb_5_1 { gpios = <&axi_gpio_2 30 GPIO_ACTIVE_HIGH>; };
		tbb_5_2 { gpios = <&axi_gpio_2 31 GPIO_ACTIVE_HIGH>; };
		tbb_6_0 { gpios = <&axi_gpio_3 5  GPIO_ACTIVE_HIGH>; };
		tbb_6_1 { gpios = <&axi_gpio_3 6  GPIO_ACTIVE_HIGH>; };
		tbb_6_2 { gpios = <&axi_gpio_3 7  GPIO_ACTIVE_HIGH>; };
		tbb_7_0 { gpios = <&axi_gpio_3 29 GPIO_ACTIVE_HIGH>; };
		tbb_7_1 { gpios = <&axi_gpio_3 30 GPIO_ACTIVE_HIGH>; };
		tbb_7_2 { gpios = <&axi_gpio_3 31 GPIO_ACTIVE_HIGH>; };
	};
	led_panel_0_0 {
		compatible = "gpio-leds";
		out_a_0	{ gpios = <&lp5860t_0  0 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 0  GPIO_ACTIVE_HIGH>; };
		out_b_0	{ gpios = <&lp5860t_0  1 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 1  GPIO_ACTIVE_HIGH>; };
		rsw_0	{ gpios = <&lp5860t_0  2 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 8  GPIO_ACTIVE_HIGH>; };
		msw1_0	{ gpios = <&lp5860t_0  3 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 9  GPIO_ACTIVE_HIGH>; };
		msw2_0	{ gpios = <&lp5860t_0  4 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 10 GPIO_ACTIVE_HIGH>; };
		out_a_1	{ gpios = <&lp5860t_0  5 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 2  GPIO_ACTIVE_HIGH>; };
		out_b_1	{ gpios = <&lp5860t_0  6 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 3  GPIO_ACTIVE_HIGH>; };
		rsw_1	{ gpios = <&lp5860t_0  7 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 11 GPIO_ACTIVE_HIGH>; };
		msw1_1	{ gpios = <&lp5860t_0  8 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 12 GPIO_ACTIVE_HIGH>; };
		msw2_1	{ gpios = <&lp5860t_0  9 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 13 GPIO_ACTIVE_HIGH>; };
		out_a_2	{ gpios = <&lp5860t_0 10 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 24 GPIO_ACTIVE_HIGH>; };
		out_b_2	{ gpios = <&lp5860t_0 11 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 25 GPIO_ACTIVE_HIGH>; };
		rsw_2	{ gpios = <&lp5860t_0 12 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 32 GPIO_ACTIVE_HIGH>; };
		msw1_2	{ gpios = <&lp5860t_0 13 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 33 GPIO_ACTIVE_HIGH>; };
		msw2_2	{ gpios = <&lp5860t_0 14 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 34 GPIO_ACTIVE_HIGH>; };
		out_a_3	{ gpios = <&lp5860t_0 16 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 26 GPIO_ACTIVE_HIGH>; };
		out_b_3	{ gpios = <&lp5860t_0 17 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 27 GPIO_ACTIVE_HIGH>; };
		rsw_3	{ gpios = <&lp5860t_0 18 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 35 GPIO_ACTIVE_HIGH>; };
		msw1_3	{ gpios = <&lp5860t_0 19 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 36 GPIO_ACTIVE_HIGH>; };
		msw2_3	{ gpios = <&lp5860t_0 20 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 37 GPIO_ACTIVE_HIGH>; };
		din_0	{ gpios = <&lp5860t_0 48 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 16 GPIO_ACTIVE_HIGH>; };
		din_1	{ gpios = <&lp5860t_0 49 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 17 GPIO_ACTIVE_HIGH>; };
		din_2	{ gpios = <&lp5860t_0 50 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 18 GPIO_ACTIVE_HIGH>; };
		din_3	{ gpios = <&lp5860t_0 51 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 19 GPIO_ACTIVE_HIGH>; };
		din_4	{ gpios = <&lp5860t_0 52 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 40 GPIO_ACTIVE_HIGH>; };
		din_5	{ gpios = <&lp5860t_0 53 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 41 GPIO_ACTIVE_HIGH>; };
		din_6	{ gpios = <&lp5860t_0 54 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 42 GPIO_ACTIVE_HIGH>; };
		din_7	{ gpios = <&lp5860t_0 55 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 43 GPIO_ACTIVE_HIGH>; };
		dout_0	{ gpios = <&lp5860t_0 64 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 20 GPIO_ACTIVE_HIGH>; };
		dout_1	{ gpios = <&lp5860t_0 65 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 21 GPIO_ACTIVE_HIGH>; };
		dout_2	{ gpios = <&lp5860t_0 66 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 22 GPIO_ACTIVE_HIGH>; };
		dout_3	{ gpios = <&lp5860t_0 67 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 23 GPIO_ACTIVE_HIGH>; };
		dout_4	{ gpios = <&lp5860t_0 68 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 44 GPIO_ACTIVE_HIGH>; };
		dout_5	{ gpios = <&lp5860t_0 69 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 45 GPIO_ACTIVE_HIGH>; };
		dout_6	{ gpios = <&lp5860t_0 70 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 46 GPIO_ACTIVE_HIGH>; };
		dout_7	{ gpios = <&lp5860t_0 71 GPIO_ACTIVE_HIGH>; linux,default-trigger = "gpio"; trigger-sources = <&axi_gpio_0 47 GPIO_ACTIVE_HIGH>; };
	};
	led_panel_0_1 {
		compatible = "gpio-leds";
